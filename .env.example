# ---------------------------------------------------------------------------
# Cluster CLI configuration
# Copy to `.env` in the project root, or export these in your shell.
# Precedence: CLI flags > project config (cluster.config.json) > global config
#             (~/.cluster/config.json) > environment > defaults
# ---------------------------------------------------------------------------

# Model provider (any OpenAI-compatible chat completions API)
CLUSTER_API_KEY=sk-...
CLUSTER_BASE_URL=https://api.openai.com/v1
CLUSTER_MODEL=gpt-4o-mini

# Optional: force the tool protocol instead of auto-detecting.
#   auto (default) - try native function calling, fall back to text protocol
#   native         - always send tools as JSON schema functions
#   text           - never send tools; ask the model to emit tool blocks
# CLUSTER_TOOL_MODE=auto

# Safety: require confirmation before destructive actions
CLUSTER_CONFIRM_DESTRUCTIVE=true
# Safety: ask before every shell command (paranoid mode)
# CLUSTER_CONFIRM_COMMANDS=false

# Agent loop
CLUSTER_MAX_ITERATIONS=40
CLUSTER_COMMAND_TIMEOUT_MS=120000

# Storage
# CLUSTER_HOME=~/.cluster

# Logs
CLUSTER_LOG_LEVEL=info
