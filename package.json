{
  "name": "cluster-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cluster CLI - Terminal-first AI coding assistant. Phase 1: a reliable MVP foundation.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "build": "tsc -b",
    "rebuild": "tsc -b --force",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --pretty false",
    "dev": "npm --workspace=cluster-electron run dev",
    "start": "npm --workspace=cluster-electron run start",
    "cluster": "npm --workspace=cluster-electron run start",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:dev": "npm --workspace=cluster-electron run dev",
    "electron:build": "npm --workspace=cluster-electron run build",
    "electron:package": "npm --workspace=cluster-electron run build:installer"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
