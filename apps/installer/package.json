{
  "name": "cluster-installer",
  "version": "0.1.0",
  "private": true,
  "description": "Cluster Desktop Installer — custom branded Windows installer",
  "author": "Abrar Safin",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "npm run build:main && npm run build:preload && npm run build:preload:fix && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:preload:fix": "node -e \"require('fs').writeFileSync('dist/preload/package.json', JSON.stringify({type:'commonjs'}))\"",
    "build:renderer": "vite build --config vite.config.ts",
    "build:package": "electron-builder --win --x64"
  },
  "dependencies": {
    "lucide-react": "^1.39.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "31.7.7",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "ai.cluster.installer",
    "productName": "Cluster Setup",
    "electronVersion": "31.7.7",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Cluster-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Cluster-Setup-${version}.exe",
      "requestExecutionLevel": "user"
    }
  }
}
